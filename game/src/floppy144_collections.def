/*
 * Master collection list
 *
 * This file intentionally has no include guard. It is an X-macro definition
 * file and is included several times with FLOPPY144_COLLECTION defined
 * differently.
 *
 * Adding a standard collection begins here.
 *
 * Arguments:
 *   symbol
 *   player-facing code
 *   official title
 *   game act
 *   collection class
 *   restored automatically
 *   terminal description
 *   evidence-found description
 *   catalogue record count
 *   catalogue heading
 *   generated record ID prefix
 *   procedural subject vocabulary
 *   procedural subject count
 *   subjects are complete titles
 *   generated record-number base
 *   generated record-number multiplier
 *   generated record-number offset
 */

FLOPPY144_COLLECTION(
    DR01,
    "DR-01",
    "DISK RECOVERY INDEX",
    FLOPPY144_ACT_PROLOGUE,
    FLOPPY144_COLLECTION_CLASS_MANDATORY,
    true,
    "CONTAINS DISK MANIFEST, OPERATING GUIDANCE AND RECOVERY NOTES.",
    NULL,
    15U,
    "DISK RECOVERY INDEX",
    "DR-01-RS",
    floppy144_dr01_record_titles,
    15U,
    true,
    0U,
    1U,
    1U
)

FLOPPY144_COLLECTION(
    HR02,
    "HR-02",
    "PERSONNEL LIFECYCLE RECORDS",
    FLOPPY144_ACT_ONE,
    FLOPPY144_COLLECTION_CLASS_ADMINISTRATIVE,
    false,
    "CONTAINS STAFF ALLOCATION AND DESK ASSIGNMENT RECORDS.",
    "EVIDENCE FOUND: DESK REALLOCATION MEMORANDUM.",
    50U,
    "PERSONNEL LIFECYCLE RECORDS",
    "HR-02-RS",
    floppy144_hr02_record_subjects,
    10U,
    false,
    1400U,
    37U,
    19U
)

FLOPPY144_COLLECTION(
    FA03,
    "FA-03",
    "SITE SAFETY AND SUPPRESSION SYSTEMS",
    FLOPPY144_ACT_ONE,
    FLOPPY144_COLLECTION_CLASS_OPERATIONAL,
    false,
    "CONTAINS FIRE SAFETY AND SUPPRESSION MAINTENANCE RECORDS.",
    "EVIDENCE FOUND: SUPPRESSION PANEL SERVICE NOTE.",
    50U,
    "SITE SAFETY AND SUPPRESSION SYSTEMS",
    "FA-03-RS",
    floppy144_fa03_record_subjects,
    10U,
    false,
    2400U,
    53U,
    11U
)
