/*
 * Floppy//144 master collection ledger
 *
 * This file intentionally has no include guard. It is an X-macro definition
 * file and is included several times with FLOPPY144_COLLECTION defined
 * differently.
 *
 * Arguments:
 *   symbol
 *   player-facing code
 *   official title
 *   archive domain
 *   reconstruction contribution percentage
 *   terminal description
 *   evidence-found description
 *   catalogue record count
 *   catalogue heading
 *   generated record ID prefix
 *   procedural subject vocabulary
 *   procedural subject count
 *   subjects are complete titles
 *   generated record-number base
 *   generated record-number multiplier
 *   generated record-number offset
 */


/*
 * Registered collections whose catalogue content has not yet been populated.
 *
 * A zero record count deliberately prevents the catalogue UI from opening a
 * generated record browser while preserving the final collection identity,
 * domain and reconstruction contribution.
 */

#define FLOPPY144_COLLECTION_STUB(                                 \
    symbol,                                                        \
    code_text,                                                     \
    title_text,                                                    \
    domain_value,                                                  \
    reconstruction_percent_value                                  \
)                                                                  \
    FLOPPY144_COLLECTION(                                          \
        symbol,                                                    \
        code_text,                                                 \
        title_text,                                                \
        domain_value,                                              \
        reconstruction_percent_value,                              \
        "REGISTERED COLLECTION. RECORD POPULATION PENDING.",       \
        NULL,                                                      \
        0U,                                                        \
        NULL,                                                      \
        NULL,                                                      \
        NULL,                                                      \
        0U,                                                        \
        false,                                                     \
        0U,                                                        \
        0U,                                                        \
        0U                                                         \
    )


