/*
 * Floppy//144 - GDR Site terminal definitions
 *
 * This file identifies the rooms containing operational GDR terminals.
 *
 * Physical position and dimensions do NOT belong here.
 * site_layout.jsonc remains the single authoritative source of Site geometry.
 *
 * Format:
 *
 * FLOPPY144_TERMINAL(
 *     symbol,
 *     room,
 *     display_name
 * )
 */

FLOPPY144_TERMINAL(
    RECEPTION,
    FLOPPY144_ROOM_RECEPTION,
    "RECEPTION TERMINAL"
)

FLOPPY144_TERMINAL(
    MAIN_OFFICE,
    FLOPPY144_ROOM_MAIN_OFFICE,
    "MAIN OFFICE TERMINAL"
)

