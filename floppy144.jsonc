  "evidence": [
    {
      "id": "E-001",
      "statement": "The manual discharge control for the Server Room Halon suppression system remained physically connected.",
      "physical_items_description": "Wall-mounted fire-suppression control panel",
      "physical_item_ids": [
        "P-012"
      ],
      "location": "Main Office, wall-mounted fixture",
      "restored_by": "FM-13 – Site Safety & Suppression Systems. Trigger: suppression-control service note",
      "collection_ids": [
        "FM-13"
      ],
      "act": "Act I: Complication",
      "importance": "Core",
      "notebook_entry": "The manual discharge control remained physically connected.",
      "reinterprets": "Introduces the possibility that the suppression system was capable of manual activation but does not establish that anybody activated it.",
      "source_order": 1
    },
    {
      "id": "E-002",
      "statement": "The Server Room Halon suppression system was deliberately scheduled to remain operational until final Site handover.",
      "physical_items_description": "Final Isolation Register",
      "physical_item_ids": [
        "P-033"
      ],
      "location": "Facilities Room, accessible shelving/bookcase",
      "restored_by": "FM-07 – Asset Management & Decommissioning. Trigger: retained-services/decommissioning schedule",
      "collection_ids": [
        "FM-07"
      ],
      "act": "Act I: Complication",
      "importance": "Core",
      "notebook_entry": "The Halon suppression system was deliberately kept operational during the final stages of Site closure.",
      "reinterprets": "E-001. The connected manual discharge control was not necessarily something Facilities had forgotten to isolate. The suppression system was meant to remain live.",
      "source_order": 2
    },
    {
      "id": "E-003",
      "statement": "Final Site handover remained incomplete because physical archive reconciliation and terminal-network remediation were still outstanding.",
      "physical_items_description": "Site Closure Handover Folder",
      "physical_item_ids": [
        "P-014"
      ],
      "location": "Main Office, Project Manager’s desk",
      "restored_by": "FM-07 – Asset Management & Decommissioning. Trigger: final isolation/handover reference",
      "collection_ids": [
        "FM-07"
      ],
      "act": "Act I: Complication",
      "importance": "Core",
      "notebook_entry": "Final Site handover remained incomplete because archive reconciliation and terminal-network remediation were still outstanding.",
      "reinterprets": "Reframes the incomplete shutdown as a consequence of unfinished closure work rather than an unexplained failure to decommission the Site. It provides the foundation for DR-04 and the Act II branch choice.",
      "source_order": 3
    },
    {
      "id": "E-004",
      "statement": "At least one record absent from its registered cabinet location was still physically present in the Records Office awaiting refiling.",
      "physical_items_description": "Record folder with reconciliation/refiling slip",
      "physical_item_ids": [
        "P-040",
        "P-041"
      ],
      "location": "Records Office, Records Trolley",
      "restored_by": "DR-07 – Archive Holdings & Reconciliation. Trigger: outstanding reconciliation report",
      "collection_ids": [
        "DR-07"
      ],
      "act": "Act II: Reinterpretation",
      "importance": "Route-core: Records",
      "notebook_entry": "A record absent from its registered cabinet location was still present in the Records Office awaiting refiling.",
      "reinterprets": "Challenges the assumption that “not found in its catalogue location” means lost, removed from Site or interfered with.",
      "source_order": 4
    },
    {
      "id": "E-005",
      "statement": "Some records apparently missing from archive storage had been deliberately withdrawn and staged for transfer as part of Site closure.",
      "physical_items_description": "Labelled archive transfer box and corresponding cabinet withdrawal marker",
      "physical_item_ids": [
        "P-046",
        "P-047"
      ],
      "location": "Records Office, Records Trolley / relevant cabinet exterior marker",
      "restored_by": "DR-29 – Archive Transfer & Custody. Trigger: Final Transfer Batch Custody Register",
      "collection_ids": [
        "DR-29"
      ],
      "act": "Act II: Reinterpretation",
      "importance": "Route-core: Records",
      "notebook_entry": "Some archive holdings were deliberately removed from storage and staged for transfer.",
      "reinterprets": "E-004. Not every disagreement between catalogue and cabinet represents a filing mistake. Some discrepancies were deliberate and controlled.",
      "source_order": 5
    },
    {
      "id": "E-006",
      "statement": "The Senior Archivist had personally accepted responsibility for resolving the remaining archive-transfer exceptions before final handover.",
      "physical_items_description": "Signed Final Transfer Exception / custody sheet",
      "physical_item_ids": [
        "P-052",
        "P-053"
      ],
      "location": "Records Office, Senior Archivist’s desk",
      "restored_by": "DR-31 – Archive Transfer Authorisation & Exceptions. Trigger: Final Transfer Exception Register",
      "collection_ids": [
        "DR-31"
      ],
      "act": "Act II: Reinterpretation",
      "importance": "Route-core: Records",
      "notebook_entry": "The Senior Archivist was personally responsible for resolving outstanding archive-transfer exceptions before final handover.",
      "reinterprets": "Turns the Senior Archivist from a background member of staff into a person directly involved in the unresolved final-day work. It also establishes why Technology Services verification mattered to Records.",
      "source_order": 6
    },
    {
      "id": "E-007",
      "statement": "The Office Terminal itself passed local checks; its failure concerned connectivity to the Site Terminal Network.",
      "physical_items_description": "Office Terminal and local network connection/diagnostic state",
      "physical_item_ids": [
        "P-017"
      ],
      "location": "Main Office, dedicated Office Terminal desk",
      "restored_by": "TS-02 – Terminal Network Support. Trigger: Office Terminal Connectivity Fault Report",
      "collection_ids": [
        "TS-02"
      ],
      "act": "Act II: Reinterpretation",
      "importance": "Route-core: Technology",
      "notebook_entry": "The Office Terminal remained operational; its connection to the Site Terminal Network had failed upstream.",
      "reinterprets": "Corrects the simple assumption that IT Support had been repairing a broken terminal. The terminal was functioning and the fault lay elsewhere.",
      "source_order": 7
    },
    {
      "id": "E-008",
      "statement": "The Office Terminal circuit was correctly connected through the IT Support distribution equipment, and the affected route continued into the Server Room.",
      "physical_items_description": "Wall-mounted network distribution cabinet / patch panel",
      "physical_item_ids": [
        "P-057",
        "P-058"
      ],
      "location": "IT Support Office",
      "restored_by": "TS-06 – Network Infrastructure & Cabling. Trigger: Terminal Network Cable Route Investigation",
      "collection_ids": [
        "TS-06"
      ],
      "act": "Act II: Reinterpretation",
      "importance": "Route-core: Technology",
      "notebook_entry": "The Office Terminal circuit was correctly patched through IT Support, with the affected route continuing into the Server Room.",
      "reinterprets": "E-007. The fault is narrowed again. Neither the Office Terminal nor the local IT Support distribution point explains the loss of connectivity.",
      "source_order": 8
    },
    {
      "id": "E-009",
      "statement": "Technology Services had prepared the final digital archive verification work, but it could not be completed because the required source holdings were unavailable through the affected network route.",
      "physical_items_description": "Final Archive Transfer Digital Verification Pack",
      "physical_item_ids": [
        "P-066",
        "P-067"
      ],
      "location": "IT Support Office, IT Manager’s workbench or open technical shelving",
      "restored_by": "TS-10 – Digital Holdings & Verification. Trigger: Final Digital Holdings Verification Report",
      "collection_ids": [
        "TS-10"
      ],
      "act": "Act II: Reinterpretation",
      "importance": "Route-core: Technology",
      "notebook_entry": "Digital verification of the final archive transfer had been prepared but could not proceed without access to the affected systems.",
      "reinterprets": "Shows that Technology Services had not neglected the handover work. Their portion was prepared but blocked by the unresolved network fault. It also reveals that the Records workstream mattered, without unlocking it during Act II.",
      "source_order": 9
    },
    {
      "id": "E-010",
      "statement": "Final Site closure was suspended after the incident pending Operational Security review and completion of the remaining handover workstream.",
      "physical_items_description": "Project Manager exception sheet",
      "physical_item_ids": [
        "P-021"
      ],
      "location": "Main Office, Project Manager’s desk",
      "restored_by": "DR-47 – Final Closure Exceptions & Incident Review",
      "collection_ids": [
        "DR-47"
      ],
      "act": "Act III: Resolution",
      "importance": "Core Act III transition",
      "notebook_entry": "Final closure was suspended pending Operational Security review and completion of the remaining handover workstream.",
      "reinterprets": "E-003. The unfinished workstreams existed before the incident; the incident then formally halted completion of the closure process.",
      "source_order": 10
    },
    {
      "id": "E-011",
      "statement": "The Site closure was an authorised centralisation and digital-transition project, not an emergency, covert or security-driven shutdown.",
      "physical_items_description": "Signed executive closure briefing",
      "physical_item_ids": [
        "P-080"
      ],
      "location": "Director’s Office, secure cabinet",
      "restored_by": "DR-53 – Executive Closure Correspondence",
      "collection_ids": [
        "DR-53"
      ],
      "act": "Act III: Resolution",
      "importance": "Optional but strong contextual evidence",
      "notebook_entry": "The Site closure was an authorised centralisation and digital-transition project; no exceptional security closure had been ordered before the incident.",
      "reinterprets": "Removes one of the largest possible false theories about why the Site was closing.",
      "source_order": 11
    },
    {
      "id": "E-012",
      "statement": "IT Support held standing access to the Server Room, while the Senior Archivist had temporary authorised access associated with final archive verification.",
      "physical_items_description": "P-159 Restricted Area Access Matrix + P-160 Temporary Restricted Area Authorisation",
      "physical_item_ids": [
        "P-159",
        "P-160"
      ],
      "location": "Security Office, Security Officer desk / adjacent access-control material",
      "restored_by": "OS-18 – Access Control & Restricted Areas",
      "collection_ids": [
        "OS-18"
      ],
      "act": "Act III: Resolution",
      "importance": "Core corroboration",
      "notebook_entry": "IT Support held standing Server Room access; the Senior Archivist had temporary authorised access for final archive-verification work.",
      "reinterprets": "Presence in or near the Server Room is not suspicious merely because the area was restricted. Both relevant staff had legitimate reasons to be there.",
      "source_order": 12
    },
    {
      "id": "E-013",
